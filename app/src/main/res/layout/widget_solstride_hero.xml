<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hero_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_hero_amber"
    android:orientation="vertical"
    android:padding="11dp">

    <!-- Header: Hero Level, Specialization, Hero Power & Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Lv.1 Solar Vanguard"
                android:textColor="#FFF8EE"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hero_spec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="☀ Sunshield Paladin"
                android:textColor="#FBBF24"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hero_power_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_badge_gold"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="PWR 180"
            android:textColor="#FFD166"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/hero_refresh_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_subcard"
            android:contentDescription="Refresh Hero Build and Armory widget"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- Vitals & Combat Stats Subcard -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_subcard"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Side-by-side compact HP & Stride Energy bars -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hero_hp_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="HP 140/140"
                    android:textColor="#4ADE80"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/hero_hp_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="100"
                    android:progressDrawable="@drawable/widget_progress_hp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hero_energy_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="EN 40/100"
                    android:textColor="#FBBF24"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/hero_energy_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="40"
                    android:progressDrawable="@drawable/widget_progress_energy" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hero_stats_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="ATK 28 • DEF 20 • CRIT 8%"
            android:textColor="#FFF5E6"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hero_gear_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🛡 0/5 Armor Equipped • Forge Armor!"
            android:textColor="#FCD34D"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Forge Treasury & Blacksmith Shortcut Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/hero_treasury_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_subcard"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="4dp"
            android:paddingEnd="7dp"
            android:paddingBottom="4dp"
            android:text="🪙 0 • ☀ 75 • ⛏ 25 • ✨ 12"
            android:textColor="#E9D8C0"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/hero_forge_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_badge_gold"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="🔨 FORGE"
            android:textColor="#FFD166"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
