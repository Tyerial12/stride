<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/steps_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_steps_cyan"
    android:orientation="vertical"
    android:padding="11dp">

    <!-- Header: Today's Big Steps, Watch Link Badge & Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/steps_big_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="0 Steps"
                android:textColor="#ECFEFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/steps_goal_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Goal 6,000 (0%) • Week 0"
                android:textColor="#7DD3FC"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/steps_watch_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_badge_cyan"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="📱 Phone"
            android:textColor="#5CE1FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/steps_refresh_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_subcard_cyan"
            android:contentDescription="Refresh Steps, Sleep and Expedition widget"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/steps_goal_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_steps" />

    <!-- Watch Sleep & Next Step-Reward Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_subcard_cyan"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="7dp">

        <TextView
            android:id="@+id/steps_sleep_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="☀ Awake • Watch Sleep Ready"
            android:textColor="#C4B5FD"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/steps_reward_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="⭐ Steps→Hero XP • ⚡ +1 Pet Stamina in 250 steps"
            android:textColor="#A5F3FC"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/steps_expedition_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_energy"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Live Timed Expedition Countdown & CTA Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/steps_expedition_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🏕 Camp Ready • Launch Expedition"
            android:textColor="#FCD34D"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/steps_open_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_badge_cyan"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:text="EXPEDITION →"
            android:textColor="#5CE1FF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
