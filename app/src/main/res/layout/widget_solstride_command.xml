<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cmd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_command_crimson"
    android:orientation="vertical"
    android:padding="11dp">

    <!-- Header: Campaign Realm, Spire Floor, Encounter Pill & Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cmd_header_zone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cmd_realm_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="⚔ R1-1 • Sunlit Dunes"
                android:textColor="#FFF5F3"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cmd_spire_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Spire Floor 1 • Bosses Slain: 0"
                android:textColor="#F2B8B5"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/cmd_encounter_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_badge_gold"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="Radar 35%"
            android:textColor="#FFD166"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/cmd_refresh_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_subcard_crimson"
            android:contentDescription="Refresh Battle and Campaign Radar widget"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- Encounter Radar Progress Gauge -->
    <LinearLayout
        android:id="@+id/cmd_radar_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/cmd_radar_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Encounter Radar: 35% to Next Ambush"
            android:textColor="#FFD8D4"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/cmd_radar_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="35"
            android:progressDrawable="@drawable/widget_progress_encounter" />
    </LinearLayout>

    <!-- 3-Tile Actionable Alerts Strip: Chests, Quests, Skill Points -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cmd_chests_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_subcard_crimson"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/cmd_chests_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎁 0"
                android:textColor="#FFD166"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cmd_chests_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="CHESTS"
                android:textColor="#E5C0BC"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cmd_quests_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_subcard_crimson"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/cmd_quests_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📜 0"
                android:textColor="#4ADE80"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cmd_quests_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="QUESTS"
                android:textColor="#E5C0BC"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cmd_points_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_subcard_crimson"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:id="@+id/cmd_points_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ 2"
                android:textColor="#C084FC"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cmd_points_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="SKILL PTS"
                android:textColor="#E5C0BC"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3-Button Tactical Quick-Launch Dock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cmd_battle_cta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_alert_crimson"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="⚔ BATTLE"
            android:textColor="#FFE2E0"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cmd_forge_cta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_badge_gold"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="🔨 FORGE"
            android:textColor="#FFD166"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cmd_map_cta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_badge_cyan"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="🗺 MAP"
            android:textColor="#5CE1FF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
