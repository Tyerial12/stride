<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_pet_violet"
    android:orientation="vertical"
    android:padding="11dp">

    <!-- Header: Pet Identity, Stamina Pill & Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pet_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="🐾 No Companion"
                android:textColor="#F8F0FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pet_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Adopt a pet in Sanctuary"
                android:textColor="#D8B4FE"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pet_stamina_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_badge_violet"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="⚡ 3/5"
            android:textColor="#E9D5FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/pet_refresh_btn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_bg_subcard_violet"
            android:contentDescription="Refresh Pet Arena widget"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- App-Open Lockout Banner -->
    <TextView
        android:id="@+id/pet_lock_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_bg_alert_crimson"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="🔒 APP OPEN — Close Solstride to Feed or Fight Wild Pets"
        android:textColor="#FFD6D6"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Exclusive Pet XP, Mood, Synergy & Wild Battle Log -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_bg_subcard_violet"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pet_xp_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="XP 0/60"
                android:textColor="#E9D5FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pet_mood_wins_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="❤ 65% • 🍖 1 • 🏆 0W"
                android:textColor="#FCD34D"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/pet_xp_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="3dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_pet" />

        <TextView
            android:id="@+id/pet_synergy_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Hero Synergy: Equip a companion in Sanctuary"
            android:textColor="#6EE7B7"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pet_battle_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Close app &amp; tap Feed or Wild Fight to level your pet!"
            android:textColor="#DFD0F2"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Direct Interactive Arena Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pet_feed_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_bg_badge_emerald"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="🍖 FEED"
            android:textColor="#6EE7B7"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pet_fight_btn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:layout_weight="1.25"
            android:background="@drawable/widget_bg_badge_violet"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="⚔ WILD FIGHT"
            android:textColor="#F3E8FF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pet_open_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_bg_subcard_violet"
            android:paddingStart="8dp"
            android:paddingTop="5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="5dp"
            android:text="🐾 PETS"
            android:textColor="#D8B4FE"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
