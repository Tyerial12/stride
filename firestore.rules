rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidHeroClass(cls) {
      return cls is string && cls in ['VANGUARD', 'ARCANIST', 'RANGER', 'SHADOWBLADE', 'STRIDER', 'SUNBLADE'];
    }

    function isValidAvatarConfig(cfg) {
      return cfg is string && cfg.matches('^[0-9](,[0-9]){5}$');
    }

    function isValidSlot(slot) {
      return slot is string && slot in ['WEAPON', 'ARMOR', 'HELM', 'BOOTS', 'RING', 'RELIC', 'CONSUMABLE'];
    }

    function isValidRarity(rarity) {
      return rarity is string && rarity in ['COMMON', 'RARE', 'EPIC', 'SOLAR', 'ULTRA_RARE'];
    }

    function isValidPerkType(perk) {
      return perk is string && perk in [
        'NONE', 'CRIT_CHANCE', 'ARMOR_PIERCE', 'LIFESTEAL', 'SOLAR_SURGE',
        'DAMAGE_REDUCTION', 'THORNS', 'EXPEDITION_WARD', 'TURN_REGEN'
      ];
    }

    function isValidChestTier(tier) {
      return tier is string && tier in [
        'HIGHLAND', 'BOSS_VAULT', 'EXPEDITION', 'SPIRE_SOVEREIGN'
      ];
    }

    function isValidPetType(petType) {
      return petType is string && petType in [
        'SUNFOX_KIT', 'AEGIS_SCARAB', 'DUNE_FALCON',
        'CINDER_LYNX', 'OASIS_TORTOISE', 'SOLAR_PHOENIX'
      ];
    }

    function isValidPetWeaponId(weaponId) {
      return weaponId is string && weaponId in [
        '', 'pet_wpn_bronze_fang', 'pet_wpn_sunsteel_talon', 'pet_wpn_zenith_spire'
      ];
    }

    function isValidPetArmorId(armorId) {
      return armorId is string && armorId in [
        '', 'pet_arm_desert_harness', 'pet_arm_obsidian_barding', 'pet_arm_aegis_mantle'
      ];
    }

    function isValidEvolutionBranch(branch) {
      return branch is string && branch in ['NONE', 'VANGUARD', 'MYSTIC'];
    }

    function isValidElementalAffinity(aff) {
      return aff is string && aff in ['EMBER', 'FROST', 'VOID', 'TERRA', 'SOLAR'];
    }

    function isValidTownBuildingLevels(levels) {
      return levels is string && levels.matches('^[1-5](,[1-5]){4}$');
    }

    function intBound(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    function optInt(d, k, lo, hi) {
      return !(k in d) || (d[k] is int && d[k] >= lo && d[k] <= hi);
    }

    // --- Schema Validation Helpers (Anti-Update-Gap & Backward-Compatible Migration) ---
    function isValidHeroProfile(d) {
      return d.userId == request.auth.uid &&
             d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 50 &&
             isValidHeroClass(d.heroClass) &&
             d.level is int && d.level >= 1 && d.level <= 999 &&
             d.xp is int && d.xp >= 0 &&
             d.xpToNextLevel is int && d.xpToNextLevel >= 1 &&
             d.might is int && d.might >= 1 &&
             d.vigor is int && d.vigor >= 1 &&
             d.endurance is int && d.endurance >= 1 &&
             d.unspentPoints is int && d.unspentPoints >= 0 &&
             d.currentHp is int && d.currentHp >= 0 &&
             d.maxHp is int && d.maxHp >= 1 &&
             d.strideEnergy is int && d.strideEnergy >= 0 &&
             d.maxStrideEnergy is int && d.maxStrideEnergy >= 1 &&
             d.encounterProgress is int && d.encounterProgress >= 0 && d.encounterProgress <= 100 &&
             d.sunshards is int && d.sunshards >= 0 &&
             d.totalSteps is int && d.totalSteps >= 0 &&
             d.weeklySteps is int && d.weeklySteps >= 0 &&
             d.weekKey is string && d.weekKey.size() <= 20 &&
             d.bossesDefeated is int && d.bossesDefeated >= 0 &&
             d.heroPower is int && d.heroPower >= 1 &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time &&
             d.get('solCoins', 0) >= 0 &&
             d.get('trueBossWins', 0) >= 0 &&
             d.get('equippedPetId', '') in ['', 'SUNFOX_KIT', 'AEGIS_SCARAB', 'DUNE_FALCON', 'CINDER_LYNX', 'OASIS_TORTOISE', 'SOLAR_PHOENIX'] &&
             d.get('expeditionsCompleted', 0) >= 0 &&
             d.get('expeditionsFailed', 0) >= 0 &&
             d.get('activeExpeditionStartMs', 0) >= 0 &&
             d.get('activeExpeditionDurationMin', 0) >= 0 && d.get('activeExpeditionDurationMin', 0) <= 1380 &&
             d.get('activeExpeditionEndMs', 0) >= 0 &&
             d.get('currentRealm', 1) >= 1 && d.get('currentRealm', 1) <= 10 &&
             d.get('realmStage', 1) >= 1 && d.get('realmStage', 1) <= 5 &&
             d.get('highestRealmCleared', 0) >= 0 && d.get('highestRealmCleared', 0) <= 10 &&
             d.get('currentSpireFloor', 1) >= 1 &&
             d.get('highestSpireFloor', 0) >= 0 &&
             d.get('prestigeLevel', 0) >= 0 && d.get('prestigeLevel', 0) <= 99 &&
             d.get('skillRanks', '0,0,0,0,0,0,0,0,0').matches('^[0-5](,[0-5]){8}$') &&
             d.get('dailyQuestDateKey', '').size() <= 20 &&
             d.get('dailyBattlesWon', 0) >= 0 &&
             d.get('dailyExpeditionsDone', 0) >= 0 &&
             d.get('dailyChestsOpened', 0) >= 0 &&
             d.get('claimedQuestIds', []).size() <= 80 &&
             d.get('chestsOpenedTotal', 0) >= 0 &&
             (!('avatarConfig' in d) || isValidAvatarConfig(d.avatarConfig)) &&
             (!('characterCreated' in d) || d.characterCreated is bool) &&
             optInt(d, 'migrationVersion', 0, 99) &&
             (!('guildId' in d) || (d.guildId is string && d.guildId.size() <= 128)) &&
             (!('seasonKey' in d) || (d.seasonKey is string && d.seasonKey.size() <= 40)) &&
             optInt(d, 'seasonXp', 0, 10000000) &&
             (!('claimedSeasonTiers' in d) || (d.claimedSeasonTiers is list && d.claimedSeasonTiers.size() <= 40)) &&
             (!('townBuildingLevels' in d) || isValidTownBuildingLevels(d.townBuildingLevels)) &&
             optInt(d, 'evolutionShards', 0, 99999) &&
             optInt(d, 'mythicCores', 0, 9999) &&
             optInt(d, 'guildCrestsOwned', 0, 99);
    }

    function isValidInventoryItem(data) {
      let d = data;
      return isValidId(d.userId) &&
             d.userId == request.auth.uid &&
             d.name is string && d.name.size() >= 1 && d.name.size() <= 60 &&
             isValidSlot(d.slot) &&
             isValidRarity(d.rarity) &&
             intBound(d.attackBonus, 0, 9999) &&
             intBound(d.defenseBonus, 0, 9999) &&
             intBound(d.hpBonus, 0, 9999) &&
             intBound(d.energyBonus, 0, 999) &&
             intBound(d.healAmount, 0, 99999) &&
             intBound(d.upgradeLevel, 0, 99) &&
             intBound(d.quantity, 1, 999) &&
             d.equipped is bool &&
             d.description is string && d.description.size() <= 180 &&
             (!('perkType' in d) || isValidPerkType(d.perkType)) &&
             optInt(d, 'perkValue', 0, 100) &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    function isValidLootChest(data) {
      let d = data;
      return isValidId(d.userId) &&
             d.userId == request.auth.uid &&
             isValidChestTier(d.chestTier) &&
             d.sourceLabel is string && d.sourceLabel.size() >= 1 && d.sourceLabel.size() <= 80 &&
             intBound(d.heroLevelSnapshot, 1, 999) &&
             intBound(d.durationMinutes, 0, 1380) &&
             intBound(d.ultraRareChancePct, 0, 100) &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    function isValidOwnedPet(data) {
      let d = data;
      return isValidId(d.userId) &&
             d.userId == request.auth.uid &&
             isValidPetType(d.petType) &&
             intBound(d.level, 1, 50) &&
             intBound(d.xp, 0, 1000000) &&
             intBound(d.xpToNextLevel, 1, 1000000) &&
             isValidPetWeaponId(d.equippedWeaponId) &&
             isValidPetArmorId(d.equippedArmorId) &&
             optInt(d, 'evolutionStage', 1, 3) &&
             (!('evolutionBranch' in d) || isValidEvolutionBranch(d.evolutionBranch)) &&
             optInt(d, 'bondXp', 0, 1000000) &&
             optInt(d, 'stepsWalkedWithPet', 0, 100000000) &&
             (!('lastCareDateKey' in d) || (d.lastCareDateKey is string && d.lastCareDateKey.size() <= 20)) &&
             optInt(d, 'dailyCareActions', 0, 20) &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    function isValidLeaderboardEntry(data) {
      let d = data;
      return isValidId(d.userId) &&
             d.userId == request.auth.uid &&
             d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 50 &&
             isValidHeroClass(d.heroClass) &&
             intBound(d.heroLevel, 1, 999) &&
             intBound(d.heroPower, 1, 10000000) &&
             intBound(d.weeklySteps, 0, 10000000) &&
             d.weekKey is string && d.weekKey.size() >= 4 && d.weekKey.size() <= 20 &&
             intBound(d.bossesDefeated, 0, 1000000) &&
             optInt(d, 'prestigeLevel', 0, 99) &&
             optInt(d, 'highestSpireFloor', 0, 9999) &&
             d.publicVisible is bool &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       request.resource.data.keys().hasOnly([
                         'userId', 'displayName', 'heroClass', 'level', 'xp', 'xpToNextLevel',
                         'might', 'vigor', 'endurance', 'unspentPoints', 'currentHp', 'maxHp',
                         'strideEnergy', 'maxStrideEnergy', 'encounterProgress', 'sunshards',
                         'solCoins', 'totalSteps', 'weeklySteps', 'weekKey', 'bossesDefeated',
                         'trueBossWins', 'heroPower', 'equippedPetId', 'expeditionsCompleted',
                         'expeditionsFailed', 'activeExpeditionStartMs', 'activeExpeditionDurationMin',
                         'activeExpeditionEndMs', 'currentRealm', 'realmStage', 'highestRealmCleared',
                         'currentSpireFloor', 'highestSpireFloor', 'prestigeLevel', 'skillRanks',
                         'dailyQuestDateKey', 'dailyBattlesWon', 'dailyExpeditionsDone',
                         'dailyChestsOpened', 'claimedQuestIds', 'chestsOpenedTotal',
                         'avatarConfig', 'characterCreated',
                         'migrationVersion', 'guildId', 'seasonKey', 'seasonXp',
                         'claimedSeasonTiers', 'townBuildingLevels',
                         'evolutionShards', 'mythicCores', 'guildCrestsOwned',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidHeroProfile(request.resource.data);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'displayName', 'heroClass', 'level', 'xp', 'xpToNextLevel',
                         'might', 'vigor', 'endurance', 'unspentPoints', 'currentHp', 'maxHp',
                         'strideEnergy', 'maxStrideEnergy', 'encounterProgress', 'sunshards',
                         'solCoins', 'totalSteps', 'weeklySteps', 'weekKey', 'bossesDefeated',
                         'trueBossWins', 'heroPower', 'equippedPetId', 'expeditionsCompleted',
                         'expeditionsFailed', 'activeExpeditionStartMs', 'activeExpeditionDurationMin',
                         'activeExpeditionEndMs', 'currentRealm', 'realmStage', 'highestRealmCleared',
                         'currentSpireFloor', 'highestSpireFloor', 'prestigeLevel', 'skillRanks',
                         'dailyQuestDateKey', 'dailyBattlesWon', 'dailyExpeditionsDone',
                         'dailyChestsOpened', 'claimedQuestIds', 'chestsOpenedTotal',
                         'avatarConfig', 'characterCreated',
                         'migrationVersion', 'guildId', 'seasonKey', 'seasonXp',
                         'claimedSeasonTiers', 'townBuildingLevels',
                         'evolutionShards', 'mythicCores', 'guildCrestsOwned',
                         'updatedAt'
                       ]) &&
                       isValidHeroProfile(request.resource.data);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // --- Subcollection: /users/{userId}/inventory/{itemId} ---
      match /inventory/{itemId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(itemId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'slot', 'rarity', 'attackBonus', 'defenseBonus',
                           'hpBonus', 'energyBonus', 'healAmount', 'upgradeLevel', 'quantity',
                           'equipped', 'description', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'slot', 'rarity', 'attackBonus', 'defenseBonus',
                           'hpBonus', 'energyBonus', 'healAmount', 'upgradeLevel', 'quantity',
                           'equipped', 'description', 'perkType', 'perkValue',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidInventoryItem(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(itemId) &&
                         isValidInventoryItem(incoming()) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'rarity', 'description', 'perkType',
                           'attackBonus', 'defenseBonus', 'hpBonus', 'energyBonus',
                           'upgradeLevel', 'quantity', 'equipped', 'perkValue', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(itemId) && request.auth.uid == userId;
      }

      // --- Subcollection: /users/{userId}/chests/{chestId} ---
      match /chests/{chestId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(chestId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(chestId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'chestTier', 'sourceLabel', 'heroLevelSnapshot',
                           'durationMinutes', 'ultraRareChancePct', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'chestTier', 'sourceLabel', 'heroLevelSnapshot',
                           'durationMinutes', 'ultraRareChancePct', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidLootChest(incoming());

        allow update: if false;

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(chestId) && request.auth.uid == userId;
      }

      // --- Subcollection: /users/{userId}/pets/{petId} ---
      match /pets/{petId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(petId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(petId) &&
                         request.auth.uid == userId &&
                         petId == incoming().petType &&
                         incoming().keys().hasAll([
                           'userId', 'petType', 'level', 'xp', 'xpToNextLevel',
                           'equippedWeaponId', 'equippedArmorId', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'petType', 'level', 'xp', 'xpToNextLevel',
                           'equippedWeaponId', 'equippedArmorId',
                           'evolutionStage', 'evolutionBranch', 'bondXp',
                           'stepsWalkedWithPet', 'lastCareDateKey', 'dailyCareActions',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidOwnedPet(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(petId) &&
                         isValidOwnedPet(incoming()) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().petType == existing().petType &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'level', 'xp', 'xpToNextLevel',
                           'equippedWeaponId', 'equippedArmorId',
                           'evolutionStage', 'evolutionBranch', 'bondXp',
                           'stepsWalkedWithPet', 'lastCareDateKey', 'dailyCareActions',
                           'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(petId) && request.auth.uid == userId;
      }
    }

    // --- Collection: /leaderboard/{userId} (Public Non-PII Competitive Standings) ---
    match /leaderboard/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (resource.data.publicVisible == true || request.auth.uid == userId);
      allow list: if isSignedIn() && resource.data.publicVisible == true;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'heroClass', 'heroLevel', 'heroPower',
                         'weeklySteps', 'weekKey', 'bossesDefeated', 'publicVisible',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'heroClass', 'heroLevel', 'heroPower',
                         'weeklySteps', 'weekKey', 'bossesDefeated', 'prestigeLevel',
                         'highestSpireFloor', 'publicVisible', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidLeaderboardEntry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidLeaderboardEntry(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'heroClass', 'heroLevel', 'heroPower',
                         'weeklySteps', 'weekKey', 'bossesDefeated', 'prestigeLevel',
                         'highestSpireFloor', 'publicVisible', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // --- Collection: /town_presence/{userId} (Real-Time Multiplayer Sunhaven Plaza & Lobby) ---
    function isValidTownPresence(d) {
      return isValidId(d.userId) &&
             d.userId == request.auth.uid &&
             d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 50 &&
             isValidHeroClass(d.heroClass) &&
             intBound(d.heroLevel, 1, 999) &&
             intBound(d.heroPower, 1, 10000000) &&
             intBound(d.prestigeLevel, 0, 99) &&
             isValidAvatarConfig(d.avatarConfig) &&
             d.equippedPetId in ['', 'SUNFOX_KIT', 'AEGIS_SCARAB', 'DUNE_FALCON', 'CINDER_LYNX', 'OASIS_TORTOISE', 'SOLAR_PHOENIX'] &&
             optInt(d, 'equippedPetLevel', 1, 50) &&
             optInt(d, 'equippedPetStage', 1, 3) &&
             (!('equippedPetBranch' in d) || isValidEvolutionBranch(d.equippedPetBranch)) &&
             (d.posX is number) && d.posX >= 0.0 && d.posX <= 1.0 &&
             (d.posY is number) && d.posY >= 0.0 && d.posY <= 1.0 &&
             d.facingRight is bool &&
             d.emote is string && d.emote.size() <= 32 &&
             d.inTown is bool &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    match /town_presence/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.inTown == true;

      allow create, update: if isSignedIn() &&
                               isValidId(userId) &&
                               request.auth.uid == userId &&
                               incoming().keys().hasAll([
                                 'userId', 'displayName', 'heroClass', 'heroLevel', 'heroPower',
                                 'prestigeLevel', 'avatarConfig', 'equippedPetId', 'posX', 'posY',
                                 'facingRight', 'emote', 'inTown', 'updatedAt'
                               ]) &&
                               incoming().keys().hasOnly([
                                 'userId', 'displayName', 'heroClass', 'heroLevel', 'heroPower',
                                 'prestigeLevel', 'avatarConfig', 'equippedPetId', 'equippedPetLevel',
                                 'equippedPetStage', 'equippedPetBranch',
                                 'posX', 'posY', 'facingRight', 'emote', 'inTown', 'updatedAt'
                               ]) &&
                               isValidTownPresence(incoming());

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // --- Collection: /multiplayer_chat/{messageId} (Real-Time Global Player Chat) ---
    function isValidChatMessage(d) {
      return isValidId(d.userId) &&
             d.userId == request.auth.uid &&
             d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 50 &&
             isValidHeroClass(d.heroClass) &&
             intBound(d.heroLevel, 1, 999) &&
             isValidAvatarConfig(d.avatarConfig) &&
             d.equippedPetId in ['', 'SUNFOX_KIT', 'AEGIS_SCARAB', 'DUNE_FALCON', 'CINDER_LYNX', 'OASIS_TORTOISE', 'SOLAR_PHOENIX'] &&
             d.message is string && d.message.size() >= 1 && d.message.size() <= 240 &&
             d.channel == 'GLOBAL' &&
             d.createdAt is timestamp && d.createdAt <= request.time;
    }

    match /multiplayer_chat/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId);
      allow list: if isSignedIn() && resource.data.channel == 'GLOBAL';

      allow create: if isSignedIn() &&
                       isValidId(messageId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'heroClass', 'heroLevel',
                         'avatarConfig', 'equippedPetId', 'message', 'channel', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'heroClass', 'heroLevel',
                         'avatarConfig', 'equippedPetId', 'message', 'channel', 'createdAt'
                       ]) &&
                       isValidChatMessage(incoming());

      allow update: if false;

      allow delete: if isSignedIn() && isValidId(messageId) && existing().userId == request.auth.uid;
    }

    // --- Collection: /multiplayer_duels/{duelId} (Real-Time Turn-Based PvP Duels) ---
    function isValidDuelStatus(s) {
      return s is string && s in ['PENDING', 'ACTIVE', 'COMPLETED', 'DECLINED'];
    }

    function isValidMultiplayerDuel(d) {
      return d.participantUids is list &&
             d.participantUids.size() == 2 &&
             isValidId(d.challengerUid) &&
             isValidId(d.opponentUid) &&
             d.challengerUid != d.opponentUid &&
             d.participantUids[0] == d.challengerUid &&
             d.participantUids[1] == d.opponentUid &&
             d.challengerName is string && d.challengerName.size() >= 1 && d.challengerName.size() <= 50 &&
             isValidHeroClass(d.challengerClass) &&
             intBound(d.challengerLevel, 1, 999) &&
             intBound(d.challengerPower, 1, 10000000) &&
             isValidAvatarConfig(d.challengerAvatar) &&
             d.challengerPetId in ['', 'SUNFOX_KIT', 'AEGIS_SCARAB', 'DUNE_FALCON', 'CINDER_LYNX', 'OASIS_TORTOISE', 'SOLAR_PHOENIX'] &&
             intBound(d.challengerHp, 0, 1000000) &&
             intBound(d.challengerMaxHp, 1, 1000000) &&
             d.challengerHp <= d.challengerMaxHp &&
             d.challengerGuard is bool &&
             d.opponentName is string && d.opponentName.size() >= 1 && d.opponentName.size() <= 50 &&
             isValidHeroClass(d.opponentClass) &&
             intBound(d.opponentLevel, 1, 999) &&
             intBound(d.opponentPower, 1, 10000000) &&
             isValidAvatarConfig(d.opponentAvatar) &&
             d.opponentPetId in ['', 'SUNFOX_KIT', 'AEGIS_SCARAB', 'DUNE_FALCON', 'CINDER_LYNX', 'OASIS_TORTOISE', 'SOLAR_PHOENIX'] &&
             intBound(d.opponentHp, 0, 1000000) &&
             intBound(d.opponentMaxHp, 1, 1000000) &&
             d.opponentHp <= d.opponentMaxHp &&
             d.opponentGuard is bool &&
             isValidDuelStatus(d.status) &&
             (d.turnUid == d.challengerUid || d.turnUid == d.opponentUid) &&
             intBound(d.turnNumber, 1, 500) &&
             (d.winnerUid == '' || d.winnerUid == d.challengerUid || d.winnerUid == d.opponentUid) &&
             d.lastActionLog is string && d.lastActionLog.size() <= 240 &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    match /multiplayer_duels/{duelId} {
      allow get: if isSignedIn() && isValidId(duelId) && request.auth.uid in resource.data.participantUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;

      allow create: if isSignedIn() &&
                       isValidId(duelId) &&
                       incoming().challengerUid == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().winnerUid == '' &&
                       incoming().keys().hasAll([
                         'participantUids', 'challengerUid', 'challengerName', 'challengerClass',
                         'challengerLevel', 'challengerPower', 'challengerAvatar', 'challengerPetId',
                         'challengerHp', 'challengerMaxHp', 'challengerGuard',
                         'opponentUid', 'opponentName', 'opponentClass',
                         'opponentLevel', 'opponentPower', 'opponentAvatar', 'opponentPetId',
                         'opponentHp', 'opponentMaxHp', 'opponentGuard',
                         'status', 'turnUid', 'turnNumber', 'winnerUid', 'lastActionLog',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'participantUids', 'challengerUid', 'challengerName', 'challengerClass',
                         'challengerLevel', 'challengerPower', 'challengerAvatar', 'challengerPetId',
                         'challengerHp', 'challengerMaxHp', 'challengerGuard',
                         'opponentUid', 'opponentName', 'opponentClass',
                         'opponentLevel', 'opponentPower', 'opponentAvatar', 'opponentPetId',
                         'opponentHp', 'opponentMaxHp', 'opponentGuard',
                         'status', 'turnUid', 'turnNumber', 'winnerUid', 'lastActionLog',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidMultiplayerDuel(incoming());

      allow update: if isSignedIn() &&
                       isValidId(duelId) &&
                       request.auth.uid in existing().participantUids &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().challengerUid == existing().challengerUid &&
                       incoming().opponentUid == existing().opponentUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'challengerHp', 'challengerGuard', 'opponentHp', 'opponentGuard',
                         'status', 'turnUid', 'turnNumber', 'winnerUid', 'lastActionLog', 'updatedAt'
                       ]) &&
                       isValidMultiplayerDuel(incoming()) &&
                       (
                         (existing().status == 'PENDING' && incoming().status == 'ACTIVE' && request.auth.uid == existing().opponentUid) ||
                         (existing().status == 'PENDING' && incoming().status == 'DECLINED') ||
                         (existing().status == 'ACTIVE' && incoming().status in ['ACTIVE', 'COMPLETED'] &&
                           (request.auth.uid == existing().turnUid || incoming().status == 'COMPLETED'))
                       );

      allow delete: if isSignedIn() &&
                       isValidId(duelId) &&
                       request.auth.uid in existing().participantUids &&
                       existing().status in ['COMPLETED', 'DECLINED'];
    }

    // --- Collection: /multiplayer_pet_playdates/{playdateId} (Real-Time Pet Playdates) ---
    function isValidPlaydateStatus(s) {
      return s is string && s in ['PENDING', 'PLAYING', 'FINISHED', 'DECLINED'];
    }

    function isValidPlayActivity(a) {
      return a is string && a in ['CHASE', 'FETCH', 'SPAR', 'NAP'];
    }

    function isValidPetPlaydate(d) {
      return d.participantUids is list &&
             d.participantUids.size() == 2 &&
             isValidId(d.hostUid) &&
             isValidId(d.guestUid) &&
             d.hostUid != d.guestUid &&
             d.participantUids[0] == d.hostUid &&
             d.participantUids[1] == d.guestUid &&
             d.hostName is string && d.hostName.size() >= 1 && d.hostName.size() <= 50 &&
             isValidPetType(d.hostPetType) &&
             intBound(d.hostPetLevel, 1, 50) &&
             d.guestName is string && d.guestName.size() >= 1 && d.guestName.size() <= 50 &&
             isValidPetType(d.guestPetType) &&
             intBound(d.guestPetLevel, 1, 50) &&
             isValidPlaydateStatus(d.status) &&
             isValidPlayActivity(d.activity) &&
             intBound(d.playCount, 0, 50) &&
             intBound(d.happinessBonus, 0, 100) &&
             d.lastPlayLog is string && d.lastPlayLog.size() <= 240 &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    match /multiplayer_pet_playdates/{playdateId} {
      allow get: if isSignedIn() && isValidId(playdateId) && request.auth.uid in resource.data.participantUids;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participantUids;

      allow create: if isSignedIn() &&
                       isValidId(playdateId) &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().keys().hasAll([
                         'participantUids', 'hostUid', 'hostName', 'hostPetType', 'hostPetLevel',
                         'guestUid', 'guestName', 'guestPetType', 'guestPetLevel',
                         'status', 'activity', 'playCount', 'happinessBonus', 'lastPlayLog',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'participantUids', 'hostUid', 'hostName', 'hostPetType', 'hostPetLevel',
                         'guestUid', 'guestName', 'guestPetType', 'guestPetLevel',
                         'status', 'activity', 'playCount', 'happinessBonus', 'lastPlayLog',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidPetPlaydate(incoming());

      allow update: if isSignedIn() &&
                       isValidId(playdateId) &&
                       request.auth.uid in existing().participantUids &&
                       incoming().participantUids == existing().participantUids &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().guestUid == existing().guestUid &&
                       incoming().hostPetType == existing().hostPetType &&
                       incoming().guestPetType == existing().guestPetType &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'activity', 'playCount', 'happinessBonus', 'lastPlayLog', 'updatedAt'
                       ]) &&
                       isValidPetPlaydate(incoming()) &&
                       (
                         (existing().status == 'PENDING' && incoming().status == 'PLAYING' && request.auth.uid == existing().guestUid) ||
                         (existing().status == 'PENDING' && incoming().status == 'DECLINED') ||
                         (existing().status == 'PLAYING' && incoming().status in ['PLAYING', 'FINISHED'])
                       );

      allow delete: if isSignedIn() &&
                       isValidId(playdateId) &&
                       request.auth.uid in existing().participantUids &&
                       existing().status in ['FINISHED', 'DECLINED'];
    }

    // --- Collection: /world_bosses/{weekKey} (Shared Weekly World Boss) ---
    function isValidWorldBoss(d) {
      return d.weekKey is string && d.weekKey.size() >= 4 && d.weekKey.size() <= 20 &&
             d.bossName is string && d.bossName.size() >= 1 && d.bossName.size() <= 60 &&
             isValidElementalAffinity(d.elementalAffinity) &&
             intBound(d.maxHp, 1000, 10000000) &&
             intBound(d.currentHp, 0, 10000000) &&
             d.currentHp <= d.maxHp &&
             intBound(d.totalStrikes, 0, 10000000) &&
             d.publicVisible is bool &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    function isValidWorldBossContribution(d) {
      return isValidId(d.userId) &&
             d.userId == request.auth.uid &&
             d.weekKey is string && d.weekKey.size() >= 4 && d.weekKey.size() <= 20 &&
             d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 50 &&
             intBound(d.totalDamage, 0, 100000000) &&
             intBound(d.strikesCount, 0, 100000) &&
             intBound(d.claimedMilestoneTier, 0, 10) &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    match /world_bosses/{weekKey} {
      allow get: if isSignedIn() && isValidId(weekKey);
      allow list: if isSignedIn() && resource.data.publicVisible == true;

      allow create: if isSignedIn() &&
                       isValidId(weekKey) &&
                       incoming().weekKey == weekKey &&
                       incoming().publicVisible == true &&
                       incoming().keys().hasAll([
                         'weekKey', 'bossName', 'elementalAffinity', 'maxHp',
                         'currentHp', 'totalStrikes', 'publicVisible', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'weekKey', 'bossName', 'elementalAffinity', 'maxHp',
                         'currentHp', 'totalStrikes', 'publicVisible', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidWorldBoss(incoming());

      allow update: if isSignedIn() &&
                       isValidId(weekKey) &&
                       incoming().weekKey == existing().weekKey &&
                       incoming().bossName == existing().bossName &&
                       incoming().maxHp == existing().maxHp &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'currentHp', 'totalStrikes', 'updatedAt'
                       ]) &&
                       incoming().currentHp <= existing().currentHp &&
                       incoming().totalStrikes >= existing().totalStrikes &&
                       isValidWorldBoss(incoming());

      allow delete: if false;

      match /contributions/{userId} {
        allow get, list: if isSignedIn() && isValidId(weekKey);

        allow create, update: if isSignedIn() &&
                                 isValidId(weekKey) &&
                                 isValidId(userId) &&
                                 request.auth.uid == userId &&
                                 incoming().weekKey == weekKey &&
                                 incoming().keys().hasAll([
                                   'userId', 'weekKey', 'displayName', 'totalDamage',
                                   'strikesCount', 'claimedMilestoneTier', 'updatedAt'
                                 ]) &&
                                 incoming().keys().hasOnly([
                                   'userId', 'weekKey', 'displayName', 'totalDamage',
                                   'strikesCount', 'claimedMilestoneTier', 'updatedAt'
                                 ]) &&
                                 isValidWorldBossContribution(incoming());

        allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      }
    }

    // --- Collection: /coop_raids/{raidId} (Live 2-4 Player Co-op Boss Raids) ---
    function isValidRaidStatus(s) {
      return s is string && s in ['OPEN', 'ACTIVE', 'VICTORY'];
    }

    function isValidCoopRaid(d) {
      return isValidId(d.hostUid) &&
             d.hostName is string && d.hostName.size() >= 1 && d.hostName.size() <= 50 &&
             d.bossName is string && d.bossName.size() >= 1 && d.bossName.size() <= 60 &&
             isValidElementalAffinity(d.bossAffinity) &&
             intBound(d.bossMaxHp, 1000, 1000000) &&
             intBound(d.bossCurrentHp, 0, 1000000) &&
             d.bossCurrentHp <= d.bossMaxHp &&
             d.participantUids is list && d.participantUids.size() >= 1 && d.participantUids.size() <= 4 &&
             d.participantNames is list && d.participantNames.size() == d.participantUids.size() &&
             isValidRaidStatus(d.status) &&
             intBound(d.totalTeamDamage, 0, 10000000) &&
             d.lastActionLog is string && d.lastActionLog.size() <= 240 &&
             d.claimedUids is list && d.claimedUids.size() <= 4 &&
             d.publicVisible is bool &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    match /coop_raids/{raidId} {
      allow get: if isSignedIn() && isValidId(raidId);
      allow list: if isSignedIn() && resource.data.publicVisible == true;

      allow create: if isSignedIn() &&
                       isValidId(raidId) &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().participantUids.size() == 1 &&
                       incoming().participantUids[0] == request.auth.uid &&
                       incoming().status == 'OPEN' &&
                       incoming().publicVisible == true &&
                       incoming().keys().hasAll([
                         'hostUid', 'hostName', 'bossName', 'bossAffinity',
                         'bossMaxHp', 'bossCurrentHp', 'participantUids', 'participantNames',
                         'status', 'totalTeamDamage', 'lastActionLog', 'claimedUids',
                         'publicVisible', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'hostUid', 'hostName', 'bossName', 'bossAffinity',
                         'bossMaxHp', 'bossCurrentHp', 'participantUids', 'participantNames',
                         'status', 'totalTeamDamage', 'lastActionLog', 'claimedUids',
                         'publicVisible', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidCoopRaid(incoming());

      allow update: if isSignedIn() &&
                       isValidId(raidId) &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().bossMaxHp == existing().bossMaxHp &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'bossCurrentHp', 'participantUids', 'participantNames',
                         'status', 'totalTeamDamage', 'lastActionLog', 'claimedUids', 'updatedAt'
                       ]) &&
                       isValidCoopRaid(incoming()) &&
                       (
                         request.auth.uid in existing().participantUids ||
                         (existing().status in ['OPEN', 'ACTIVE'] && existing().participantUids.size() < 4 && request.auth.uid in incoming().participantUids)
                       );

      allow delete: if isSignedIn() &&
                       isValidId(raidId) &&
                       existing().hostUid == request.auth.uid &&
                       (existing().status == 'VICTORY' || existing().participantUids.size() <= 1);
    }

    // --- Collection: /guilds/{guildId} (Real-Player Step-Powered Guilds) ---
    function isValidGuild(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 36 &&
             d.motto is string && d.motto.size() <= 90 &&
             d.emblemHex is int &&
             isValidId(d.leaderUid) &&
             d.leaderName is string && d.leaderName.size() >= 1 && d.leaderName.size() <= 50 &&
             d.memberUids is list && d.memberUids.size() >= 1 && d.memberUids.size() <= 25 &&
             d.memberNames is list && d.memberNames.size() == d.memberUids.size() &&
             d.weekKey is string && d.weekKey.size() >= 4 && d.weekKey.size() <= 20 &&
             intBound(d.weeklyGuildSteps, 0, 100000000) &&
             intBound(d.weeklyStepGoal, 5000, 10000000) &&
             intBound(d.weeklyBossDamage, 0, 100000000) &&
             intBound(d.guildLevel, 1, 50) &&
             d.publicVisible is bool &&
             d.createdAt is timestamp && d.createdAt <= request.time &&
             d.updatedAt is timestamp && d.updatedAt <= request.time;
    }

    function isValidGuildChatMessage(d) {
      return isValidId(d.guildId) &&
             isValidId(d.userId) &&
             d.userId == request.auth.uid &&
             d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 50 &&
             intBound(d.heroLevel, 1, 999) &&
             d.message is string && d.message.size() >= 1 && d.message.size() <= 240 &&
             d.createdAt is timestamp && d.createdAt <= request.time;
    }

    match /guilds/{guildId} {
      allow get: if isSignedIn() && isValidId(guildId);
      allow list: if isSignedIn() && resource.data.publicVisible == true;

      allow create: if isSignedIn() &&
                       isValidId(guildId) &&
                       incoming().leaderUid == request.auth.uid &&
                       incoming().memberUids.size() == 1 &&
                       incoming().memberUids[0] == request.auth.uid &&
                       incoming().publicVisible == true &&
                       incoming().keys().hasAll([
                         'name', 'motto', 'emblemHex', 'leaderUid', 'leaderName',
                         'memberUids', 'memberNames', 'weekKey', 'weeklyGuildSteps',
                         'weeklyStepGoal', 'weeklyBossDamage', 'guildLevel',
                         'publicVisible', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'name', 'motto', 'emblemHex', 'leaderUid', 'leaderName',
                         'memberUids', 'memberNames', 'weekKey', 'weeklyGuildSteps',
                         'weeklyStepGoal', 'weeklyBossDamage', 'guildLevel',
                         'publicVisible', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidGuild(incoming());

      allow update: if isSignedIn() &&
                       isValidId(guildId) &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'motto', 'memberUids', 'memberNames', 'leaderUid', 'leaderName',
                         'weekKey', 'weeklyGuildSteps', 'weeklyStepGoal', 'weeklyBossDamage',
                         'guildLevel', 'updatedAt'
                       ]) &&
                       isValidGuild(incoming()) &&
                       (
                         request.auth.uid in existing().memberUids ||
                         (existing().memberUids.size() < 25 && request.auth.uid in incoming().memberUids)
                       );

      allow delete: if isSignedIn() &&
                       isValidId(guildId) &&
                       existing().leaderUid == request.auth.uid &&
                       existing().memberUids.size() <= 1;

      match /messages/{messageId} {
        allow get, list: if isSignedIn() &&
                            isValidId(guildId) &&
                            request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.memberUids;

        allow create: if isSignedIn() &&
                         isValidId(guildId) &&
                         isValidId(messageId) &&
                         incoming().guildId == guildId &&
                         request.auth.uid in get(/databases/$(database)/documents/guilds/$(guildId)).data.memberUids &&
                         incoming().keys().hasAll([
                           'guildId', 'userId', 'displayName', 'heroLevel', 'message', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'guildId', 'userId', 'displayName', 'heroLevel', 'message', 'createdAt'
                         ]) &&
                         isValidGuildChatMessage(incoming());

        allow update: if false;

        allow delete: if isSignedIn() &&
                         isValidId(guildId) &&
                         isValidId(messageId) &&
                         existing().userId == request.auth.uid;
      }
    }
  }
}
